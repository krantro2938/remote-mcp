# Reference for /etc/remote-mcp/relay.env (docker-deploy.sh generates it for you).

# LISTEN_ADDR and DATA_DIR are set by the Docker image; don't set them here.

# Public HTTPS URL of the relay, no trailing slash.
PUBLIC_URL=https://relay.example.com

# One name=token pair per machine. Tokens: openssl rand -hex 24
AGENT_TOKENS=laptop=CHANGE_ME_48_HEX_CHARS,labpc=CHANGE_ME_TOO_48_HEX_CHARS

# Password for the OAuth consent page (claude.ai), the gallery and downloads.
ADMIN_PASSWORD=CHANGE_ME

# Optional: static bearer token for Claude Code or scripts.
MCP_TOKEN=

# Optional: an unauthenticated MCP path for clients without OAuth, e.g.
# /mcp-<48 random hex chars>. Anyone who knows the URL gets full control.
MCP_SECRET_PATH=

# How long captures are kept (unlabeled / labeled).
CAPTURE_TTL=72h
LABELED_TTL=720h

# DEBUG=1
